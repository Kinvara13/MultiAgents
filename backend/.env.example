# ═══════════════════════════════════════════════════════════
# AgentNexus Backend Configuration
# Copy to .env and fill in your actual API keys
# ═══════════════════════════════════════════════════════════

# ─── Core ────────────────────────────────────────────────
APP_NAME=AgentNexus
DEBUG=false
LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ───────────────────────────────
# Install: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=secret postgres:16
DATABASE_URL=postgresql+asyncpg://agentnexus:agentnexus_secret@localhost:5432/agentnexus

# ─── Redis ───────────────────────────────────────────────
# Install: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0

# ─── MinIO (S3-compatible object storage) ────────────────
# Install: docker run -d -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address :9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret

# ─── API Keys ─── REQUIRED FOR REAL AGENT CALLS ──────────
# Get your key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# ─── JWT (for future auth) ───────────────────────────────
JWT_SECRET=your-secret-key-change-this

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
